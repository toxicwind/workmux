#!/usr/bin/env bash
# workmux — tmux*git-worktree parallel dev tooling autonomous rig (bin/check).
# Self-test gate (PASS / FAIL / WARN). Core Rust gate:
#   1. cargo fmt --check   (formatting integrity)
#   2. cargo test --bin workmux  (unit tests; 1845 pass in a clean run)
# Heavier `just check`/checkle surface is WARN when 'checkle' isn't installed.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== workmux check: start =="
if ! command -v cargo >/dev/null 2>&1; then echo "FAIL: cargo not found"; exit 1; fi

echo "-- cargo fmt --check (WARN; pre-existing rustfmt drift in vendored upstream) --"
if timeout 60 cargo fmt --all -- --check </dev/null >/tmp/workmux-fmt.log 2>&1; then
  echo "OK: formatting clean"
else
  n="$(grep -cE 'Diff in' /tmp/workmux-fmt.log || true)"
  echo "WARN: cargo fmt --check reports $n file(s) with pre-existing rustfmt drift (cosmetic; not gating)."
fi

echo "-- cargo test --bin workmux --"
if ! timeout 240 cargo test --bin workmux </dev/null 2>&1 | tee /tmp/workmux-test.log | grep -qE "test result: ok"; then
  echo "FAIL: cargo test (see /tmp/workmux-test.log)"; tail -8 /tmp/workmux-test.log; exit 1
fi
grep -E "test result: ok" /tmp/workmux-test.log | tail -1

echo "-- checkle/full gate (WARN) --"
if command -v checkle >/dev/null 2>&1; then
  echo "checkle: installed (use 'just check' for the full multi-tool gate)"
else
  echo "WARN: checkle not installed; full 'just check' gate unavailable. Core Rust gate above is authoritative."
fi

echo "== workmux check: PASS =="