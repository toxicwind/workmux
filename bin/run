#!/usr/bin/env bash
# workmux — tmux*git-worktree parallel dev tooling autonomous rig (bin/run).
# Primary operation: run the workmux CLI.
#   bin/run --help   print CLI help (fast)
#   bin/run ...      pass args to workmux (cargo run)
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v cargo >/dev/null 2>&1; then echo "FAIL: cargo not found"; exit 1; fi

if [ "${1:-}" = "--help" ] || [ $# -eq 0 ]; then
  echo "== workmux run: CLI surface =="
  exec cargo run -q -- --help 2>&1 | head -40
fi

echo "== workmux run =="
exec cargo run -q -- "$@"